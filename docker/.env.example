# Copy to docker/.env before `docker compose up`.
#
# POSTGRES_PASSWORD has no default on purpose: it used to be hardcoded as
# `sim2l_password` in docker-compose.yml and in all three service DB_URLs, which
# is exactly the kind of value that reaches a shared host unchanged. Compose now
# fails fast if it is unset rather than silently starting with a known password.
POSTGRES_PASSWORD=
