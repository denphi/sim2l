FROM python:3.11-slim

WORKDIR /app

# Copy requirements and install dependencies
COPY requirements.txt /app/
COPY requirements/ /app/requirements/
RUN pip install --no-cache-dir -r requirements.txt

# Copy sim2l package
COPY sim2l /app/sim2l

# Expose port
EXPOSE 8003

# Default to SQLite backend
ENV BACKEND=sqlite
ENV DB_PATH=/data/results.db
ENV HOST=0.0.0.0
ENV PORT=8003

# Create data directory
RUN mkdir -p /data

# Run results service
CMD python -m sim2l.services.results_service \
    --backend ${BACKEND} \
    --db-path ${DB_PATH} \
    --host ${HOST} \
    --port ${PORT}
